# Template configuration for stack: librespeed (Fill in values for local deployment)
LIBRESPEED_DOMAIN=speed.home.lan
LIBRESPEED_DATA_DIR=/srv/librespeed/config
# Letters and digits only: the image injects it unescaped into a sed command.
# Generate one with: openssl rand -hex 24
LIBRESPEED_STATS_PASSWORD=CHANGEME
CUSTOM_RESULTS=false
DB_TYPE=sqlite
# true: modern design by default, false: classic. Visitors can override with ?design=.
LIBRESPEED_NEW_DESIGN=true
# local: test against this server only, public: the image's Internet servers,
# custom: keep server-list.json as edited in the data directory.
LIBRESPEED_SERVER_LIST=local
PGID=
PUID=
TZ=Europe/Paris
