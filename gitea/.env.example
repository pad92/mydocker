# Copy to .env and use the existing production paths and database credentials.
USER_UID=1000
USER_GID=1000
GITEA_DATA_DIR=/srv/gitea/data
GITEA_DB_DATA_DIR=/srv/gitea/postgres
GITEA_RUNNER_DATA_DIR=/srv/gitea/runner
GITEA_DOMAIN=git.example.com
GITEA__server__ROOT_URL=https://git.example.com/
GITEA__database__DB_TYPE=postgres
GITEA__database__HOST=db:5432
GITEA__database__NAME=gitea
GITEA__database__USER=gitea
GITEA__database__PASSWD=
GITEA__actions__ENABLED=true
GITEA__packages__ENABLED=true
GITEA__packages__DOCKER_V2_ENABLED=true
GITEA_INSTANCE_URL=http://gitea:3000
GITEA_RUNNER_NAME=runner-01
# Read only at registration: once config.yaml lists runner.labels, those win.
GITEA_RUNNER_LABELS=ubuntu-latest:docker://docker.gitea.com/runner-images:ubuntu-latest,ubuntu-24.04:docker://docker.gitea.com/runner-images:ubuntu-24.04,ubuntu-22.04:docker://docker.gitea.com/runner-images:ubuntu-22.04
# Only needed for a new registration. Existing runners use /data/.runner.
GITEA_RUNNER_REGISTRATION_TOKEN=
