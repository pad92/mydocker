# Template configuration for stack: todo (Fill in values for local deployment)
# Host name of Authentik (AUTHENTIK_HOST_LOCAL of the management stack),
# e.g. auth.example.lan.
AUTHENTIK_DOMAIN=
# Client secret of the "Donetick" provider in Authentik (Applications >
# Providers > Donetick). Set it in Portainer, never commit it.
DONETICK_OIDC_CLIENT_SECRET=
DT_ENV=
# Also set DONETICK_HOST_LOCAL to this value in the management stack.
TODO_DOMAIN=
# Host directory with the database (donetick.db) and selfhosted.yaml
# (mounted on /donetick-data and /config). The database path is fixed in the
# compose file; a DT_SQLITE_PATH stack variable is ignored.
TODO_DONETICK_DATA_DIR=
