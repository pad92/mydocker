# Template configuration for stack: ollama (Fill in values for local deployment)
HOME_OLLAMA=
LOG_LEVEL=
MODEL_DOWNLOAD_DIR=
NVIDIA_DRIVER_CAPABILITIES=
NVIDIA_VISIBLE_DEVICES=
# Host address the Ollama API (port 11434, no authentication) is published on:
# the LAN address of the GPU host, never 0.0.0.0. Required.
OLLAMA_BIND_ADDRESS=
# Context window in tokens (default 8192).
OLLAMA_CONTEXT_LENGTH=
OLLAMA_DOMAIN=
OLLAMA_KEEP_ALIVE=
OLLAMA_MODELS_DATA_DIR=
OLLAMA_OLLAMA_DATA_DIR=
OLLAMA_OPEN_WEBUI_BACKEND_DATA_DIR=
OLLAMA_OPEN_WEBUI_DATA_DIR=
# Signs Open WebUI sessions. Required; generate it with: openssl rand -hex 32
WEBUI_SECRET_KEY=
