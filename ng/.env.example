# Template configuration for stack: ng
#
# First setup: copy this file to ng/.env (ignored by git) or paste the
# variables into the Portainer/Dockhand stack, then fill every empty value.
# Values after '#' are examples, not defaults. Keep comments on their own
# line: Compose and Portainer do not parse trailing comments the same way.
# Check the result with: docker compose -f ng/docker-compose.yml config

# --- Common ---------------------------------------------------------------

# User and group that own the config folders on the host (`id -u` / `id -g`).
PUID=1000
PGID=1000
# Container timezone.
TZ=Europe/Paris
# Host folder holding one config folder per service (radarr/, sonarr/, ...).
# Example: /srv/docker/ng
DOCKER_CONFIG_PATH=
# Root CA of the local network, mounted in every container to trust *.home.lan.
LOCAL_CA_CERT_PATH=/usr/local/share/ca-certificates/home-lan-root-ca.crt

# --- Traefik --------------------------------------------------------------

# Host served by Traefik: h5ai at /, the *arr apps under /radarr, /sonarr...
# Example: media.home.lan
TRAEFIK_FQDN=
# Dedicated host for Seerr (it cannot live under a path prefix).
# Example: requests.home.lan
SEERR_DOMAIN=

# Ports the apps listen on inside their container, used by Traefik only.
# The values below are the images' defaults; change them only if you changed
# the port in the app itself.
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
LIDARR_PORT=8686
SABNZBD_PORT=8080
PROWLARR_PORT=9696
SEERR_PORT=5055

# --- NFS ------------------------------------------------------------------

# NAS that exports the media, and IP of this Docker host as the NAS sees it.
# Example: 192.168.1.10 / 192.168.1.20
NFS_SERVER_IP=
NFS_CLIENT_IP=
# Paths exported by the NAS (paths on the NAS, not on this host).
# MEDIA_BASE_PATH must contain Movies, Movies_Family, Series, Series_Family
# and #recycle.
# Example: /volume1/medias
MEDIA_BASE_PATH=
# Example: /volume1/music
MUSIC_PATH=
# Example: /volume1/downloads
DOWNLOAD_PATH=
# Example: /volume1/backups/ng
BACKUPS_PATH=

# --- Host paths (bind mounts on this Docker host) ---------------------------

# SABnzbd incomplete downloads, local for speed. Example: /srv/downloads/incomplete
SABNZBD_DOWNLOAD_PATH=
# Torrent client download folder, seen by Radarr, Sonarr and Lidarr.
# Example: /srv/torrents
TORRENTS_PATH=
# Local series folder, seen by Sonarr and Bazarr. Example: /srv/series
SERIES_LOCAL_PATH=

# --- h5ai -----------------------------------------------------------------

# The folders under /share are not set here: list them in h5ai-shares.conf.
# Host folder that the 'bind' shares of h5ai-shares.conf start from, shared by
# all of them. Example: /volume1
H5AI_BIND_ROOT=

# Admin page password, hashed at each start. Empty keeps the stored hash.
H5AI_ADMIN_PASSWORD=CHANGEME

# --- Not read by docker-compose.yml ------------------------------------------

# Kept for reference when configuring the apps by hand (API keys are created
# by each app on first start, under Settings > General).
RADARR_API_KEY=CHANGEME
SONARR_API_KEY=CHANGEME
BAZARR_API_KEY=CHANGEME
PROWLARR_API_KEY=CHANGEME
SABNZBD_API_KEY=CHANGEME
LIDAR_POSTGRES_DB=
LIDAR_POSTGRES_USER=
LIDAR_POSTGRES_PASSWORD=CHANGEME
