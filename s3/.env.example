# Template configuration for stack: s3 (Fill in values for local deployment)
# RustFS credentials (use non-default values in production)
RUSTFS_ACCESS_KEY=CHANGEME
RUSTFS_SECRET_KEY=CHANGEME

# Host directory ownership expected by the RustFS container
RUSTFS_UID=10001
RUSTFS_GID=10001

# Legacy MinIO names are supported as a migration fallback
MINIO_ACCESS_KEY=CHANGEME
MINIO_S3_DATA_DIR=
MINIO_SECRET_KEY=CHANGEME
