#!/bin/bash
# Post-commit hook - Warn the user after commit if secrets/IPs escaped detection

# Get the root of the git repository
GIT_DIR=$(git rev-parse --show-toplevel)

# Get the hash of the newly created commit
COMMIT_HASH=$(git rev-parse HEAD)

# Run the analyzer on this commit
python3 "$GIT_DIR/.githooks/git-leak-shield.py" --commit "$COMMIT_HASH"
