# Copy to .env, fill in the blanks and run chmod 600 .env.
# Image tag of Gramps Web: latest follows the official releases, a version tag pins one.
GRAMPSWEB_VERSION=latest
# Image tag of Valkey (Celery broker and rate-limit store).
GRAMPSWEB_VALKEY_VERSION=8-alpine
# Public name behind Traefik. GRAMPSWEB_BASE_URL is https://<GRAMPSWEB_DOMAIN>.
GRAMPSWEB_DOMAIN=genealogie.example.lan
# Public name of Authentik. The OIDC issuer is
# https://<AUTHENTIK_DOMAIN>/application/o/grampsweb/.
AUTHENTIK_DOMAIN=auth.example.lan
# Client secret of the "Gramps Web" provider in Authentik (Applications >
# Providers > Gramps Web > Edit). In Portainer, put it in the stack's
# environment variables. Deployment fails while it is empty.
GRAMPSWEB_OIDC_CLIENT_SECRET=
# Name of the family tree, created on first start if it does not exist.
GRAMPSWEB_TREE=Gramps Web
# Holds users, grampsdb, indexdir, cache, thumbnail_cache, secret and tmp.
GRAMPSWEB_DATA_DIR=/srv/grampsweb
# Photos and documents linked to the tree.
GRAMPSWEB_MEDIA_DIR=/srv/grampsweb/media
# Gunicorn workers of the web server (each one costs CPU and RAM).
GUNICORN_NUM_WORKERS=8
# Parallel tasks of the Celery worker (imports, exports, reports, e-mails).
GRAMPSWEB_CELERY_CONCURRENCY=2
# SMTP for password resets and invitations. Leave GRAMPSWEB_EMAIL_HOST empty
# to turn e-mail off. Proton Mail needs a paid plan, a custom-domain address
# and an SMTP token (Settings > IMAP/SMTP > SMTP tokens), not the account
# password. In Portainer, put the token in the stack's environment variables.
GRAMPSWEB_EMAIL_HOST=smtp.protonmail.ch
GRAMPSWEB_EMAIL_PORT=587
# Proton uses STARTTLS on 587: keep implicit SSL (port 465) off.
GRAMPSWEB_EMAIL_USE_STARTTLS=true
GRAMPSWEB_EMAIL_USE_SSL=false
# The custom-domain address the SMTP token belongs to.
GRAMPSWEB_EMAIL_HOST_USER=genealogie@example.com
GRAMPSWEB_EMAIL_HOST_PASSWORD=
GRAMPSWEB_DEFAULT_FROM_EMAIL=genealogie@example.com
# AI chat. OpenAI-compatible endpoint of the Ollama stack, ending in /v1/.
# The Gramps Web containers must reach it (published port 11434 of the host that runs it).
GRAMPSWEB_LLM_BASE_URL=http://ollama.example.lan:11434/v1/
# Model with tool calling, pulled first with: ollama pull qwen2.5:7b
# Keep the "ollama:" prefix.
GRAMPSWEB_LLM_MODEL=ollama:qwen2.5:7b
# Characters of tree context per question (Gramps default: 50000).
GRAMPSWEB_LLM_MAX_CONTEXT_LENGTH=20000
