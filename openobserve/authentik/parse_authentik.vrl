# parse_authentik : normalise les logs Authentik (server, worker, postgresql)
# routés du stream docker vers le stream authentik par la pipeline docker_redact_url_secrets.
# S'exécute après redact_url_secrets (qui masque body, app_msg, app_message).
#
# Deux formats coexistent côté authentik_server :
# - Python/structlog : app_client_ip, app_runtime (ms), app_action pour les événements ;
# - Rust/axum (outpost embarqué, forward-auth) : app_remote, app_runtime (ms, chaîne).
#
# Champs ajoutés (préfixe ak_) :
#   ak_component  server | worker | postgresql
#   ak_kind       event | forward_auth | health | http | task | log
#   ak_level      debug | trace | info | warning | error | critical (warn et fatal normalisés,
#                 niveau PostgreSQL lu dans le message)
#   ak_client_ip  IP du client, quel que soit le format
#   ak_runtime_ms durée de la requête en ms (float)
#   ak_action     action d'événement Authentik (login, login_failed, authorize_application...)
#   ak_user       utilisateur visé (nom saisi pour login_failed, sinon utilisateur de l'événement)
#   ak_app_host   hôte protégé, pour les requêtes forward-auth
# ak_action et ak_user sont écrits sur chaque enregistrement, vides hors événement : OpenObserve
# refuse une requête sur un champ absent du schéma (« unknown field »), et les événements sont rares.

secret_re = r'(?i)([?&]|\b)((?:access[_-]?token|refresh[_-]?token|token|auth(?:orization)?|api[_-]?key|client[_-]?secret|credential|password|passwd|secret|session(?:[_-]?id)?|jwt|signature|sig|nonce(?:_[a-z0-9]+)?|code|key)=)([^&\s"\x27\\]*)'
if is_string(.app_event) {
  .app_event = replace(string!(.app_event), secret_re, "$1$2[REDACTED]")
}
if is_string(.app_path) {
  .app_path = replace(string!(.app_path), secret_re, "$1$2[REDACTED]")
}
if is_string(.app_context_http_request) {
  .app_context_http_request = replace(string!(.app_context_http_request), secret_re, "$1$2[REDACTED]")
}

name = string(.container_name) ?? ""
.ak_component = replace(name, r'^authentik_', "")

# string() échoue sur null, contrairement à to_string() qui rend "" : le ?? passe alors au champ suivant.
lvl = downcase(string(.app_level) ?? string(.severity) ?? "")
# PostgreSQL : le collecteur met WARN par défaut sur les lignes LOG: et les lignes de continuation ;
# le vrai niveau est dans le préfixe « [pid] NIVEAU: » du message.
if .ak_component == "postgresql" {
  m, err = parse_regex(string(.body) ?? "", r'\[\d+\] (?P<l>[A-Z0-9]+):')
  pg = if err == null { m.l } else { "" }
  if pg == "WARNING" {
    lvl = "warning"
  } else if pg == "ERROR" {
    lvl = "error"
  } else if pg == "FATAL" || pg == "PANIC" {
    lvl = "critical"
  } else {
    lvl = "info"
  }
}
# Un seul vocabulaire : warn -> warning, fatal/panic -> critical.
if lvl == "warn" { lvl = "warning" }
if lvl == "fatal" || lvl == "panic" { lvl = "critical" }
.ak_level = lvl

ip = string(.app_client_ip) ?? string(.app_remote) ?? ""
if ip != "" { .ak_client_ip = ip }

if exists(.app_runtime) {
  rt, err = to_float(.app_runtime)
  if err == null { .ak_runtime_ms = rt }
}

path = string(.app_path) ?? ""
action = string(.app_action) ?? ""
.ak_action = action
.ak_user = ""
if action != "" {
  .ak_kind = "event"
  .ak_user = string(.app_context_username) ?? string(.app_user_username) ?? ""
} else if starts_with(path, "/outpost.goauthentik.io/") {
  .ak_kind = "forward_auth"
  host = string(.app_host) ?? ""
  if host != "" { .ak_app_host = host }
} else if contains(path, "/health/") || contains(path, "/-/health/") {
  .ak_kind = "health"
} else if path != "" {
  .ak_kind = "http"
} else if exists(.app_task_name) || exists(.app_actor_name) {
  .ak_kind = "task"
} else {
  .ak_kind = "log"
}
.
