# parse_proxmox : reconnaît et normalise les logs des démons Proxmox VE arrivés dans le stream journald
# (récepteur journald du collecteur OpenTelemetry de l'hôte Proxmox).
# Appelée par la pipeline journald_http_parse après parse_http, sur tous les enregistrements journald :
# un enregistrement qui ne vient pas d'un démon Proxmox ressort inchangé, sans champ pve_*.
# La pipeline envoie les enregistrements qui ont pve_component vers le stream proxmox, les autres
# restent dans journald.
#
# Démons reconnus (body_syslog_identifier) : pve* (pvedaemon, pveproxy, pvescheduler, pveupdate,
# pvestatd, pve-ha-lrm, pve-ha-crm, pve-firewall, pve-notify-worker...), pmxcfs, proxmox-*,
# vzdump, qmeventd, spiceproxy.
#
# Champs ajoutés (préfixe pve_), écrits sur chaque enregistrement Proxmox, vides quand ils ne
# s'appliquent pas : OpenObserve refuse une requête sur un champ absent du schéma (« unknown field »).
#   pve_component  identifiant syslog du démon
#   pve_level      critical | error | warning | info | debug (priorité journald)
#   pve_kind       task | backup | auth | notification | ha | log
#   pve_task_type  type de tâche du UPID (vzdump, acmerenew, aptupdate, qmstart, vzstart...)
#   pve_task_event start | end
#   pve_task_status OK, ou message d'erreur de la tâche terminée
#   pve_task_failed true si la tâche s'est terminée autrement que par OK
#   pve_user       utilisateur PVE (root@pam...)
#   pve_vmid       VMID concerné (UPID ou ligne de sauvegarde)
#   pve_backup_event job_start | vm_start | vm_ok | vm_failed | job_ok | job_failed
#   pve_duration_s durée de sauvegarde d'un invité en secondes (vm_ok), 0 sinon
#   pve_auth_result success | failure
#   pve_client_ip  IP du client pour un échec d'authentification

ident = string(.body_syslog_identifier) ?? ""
is_pve = starts_with(ident, "pve") ||
  starts_with(ident, "proxmox-") ||
  includes(["pmxcfs", "vzdump", "qmeventd", "spiceproxy"], ident)

if is_pve {
  msg = string(.body_message) ?? ""
  .pve_component = ident

  # Priorité syslog : 0-2 critical, 3 error, 4 warning, 5-6 info, 7 debug.
  prio = to_int(.body_priority) ?? 6
  .pve_level = if prio <= 2 {
    "critical"
  } else if prio == 3 {
    "error"
  } else if prio == 4 {
    "warning"
  } else if prio == 7 {
    "debug"
  } else {
    "info"
  }

  .pve_kind = "log"
  .pve_task_type = ""
  .pve_task_event = ""
  .pve_task_status = ""
  .pve_task_failed = false
  .pve_user = ""
  .pve_vmid = ""
  .pve_backup_event = ""
  .pve_auth_result = ""
  .pve_client_ip = ""
  .pve_duration_s = 0

  # Début et fin de tâche :
  #   <root@pam> starting task UPID:node:pid:pstart:start:type:id:user:
  #   <root@pam> end task UPID:node:pid:pstart:start:type:id:user: OK | <erreur>
  task, err = parse_regex(msg, r'^<(?P<user>[^>]+)> (?P<event>starting|end) task UPID:[^:]*:[0-9A-Fa-f]+:[0-9A-Fa-f]+:[0-9A-Fa-f]+:(?P<type>[^:]*):(?P<id>[^:]*):[^:]*:\s*(?P<status>.*)$')
  if err == null {
    .pve_kind = "task"
    .pve_user = task.user
    .pve_task_type = task.type
    .pve_vmid = task.id
    if task.event == "starting" {
      .pve_task_event = "start"
    } else {
      .pve_task_event = "end"
      .pve_task_status = task.status
      .pve_task_failed = task.status != "OK"
    }
  }

  # Sauvegardes vzdump (lancées par pvescheduler ou vzdump).
  if .pve_kind == "log" {
    if match(msg, r'^INFO: starting new backup job') {
      .pve_kind = "backup"
      .pve_backup_event = "job_start"
    } else if contains(msg, "Backup job finished successfully") {
      .pve_kind = "backup"
      .pve_backup_event = "job_ok"
    } else if match(msg, r'Backup job finished with errors|ERROR: Backup job failed') {
      .pve_kind = "backup"
      .pve_backup_event = "job_failed"
    } else {
      vm, err = parse_regex(msg, r'^(?P<lvl>INFO|ERROR): (?P<what>Starting|Finished) Backup of VM (?P<id>\d+)(?: \((?P<h>\d+):(?P<m>\d+):(?P<s>\d+)\))?')
      if err == null {
        .pve_kind = "backup"
        .pve_vmid = vm.id
        if vm.what == "Starting" {
          .pve_backup_event = "vm_start"
        } else {
          .pve_backup_event = "vm_ok"
          if vm.h != null {
            .pve_duration_s = (to_int(vm.h) ?? 0) * 3600 + (to_int(vm.m) ?? 0) * 60 + (to_int(vm.s) ?? 0)
          }
        }
      } else {
        fail, err = parse_regex(msg, r'^ERROR: Backup of VM (?P<id>\d+) failed')
        if err == null {
          .pve_kind = "backup"
          .pve_vmid = fail.id
          .pve_backup_event = "vm_failed"
        }
      }
    }
    if .pve_backup_event == "job_failed" || .pve_backup_event == "vm_failed" {
      .pve_level = "error"
    }
  }

  # Authentification API et interface web.
  if .pve_kind == "log" {
    ok, err = parse_regex(msg, r'^<[^>]+> successful auth for user \x27(?P<user>[^\x27]+)\x27')
    if err == null {
      .pve_kind = "auth"
      .pve_auth_result = "success"
      .pve_user = ok.user
    } else {
      ko, err = parse_regex(msg, r'authentication failure; rhost=(?:::ffff:)?(?P<ip>\S+) user=(?P<user>\S+)')
      if err == null {
        .pve_kind = "auth"
        .pve_auth_result = "failure"
        .pve_client_ip = ko.ip
        .pve_user = ko.user
        if .pve_level == "info" { .pve_level = "warning" }
      }
    }
  }

  if .pve_kind == "log" {
    if ident == "pve-notify-worker" {
      .pve_kind = "notification"
    } else if starts_with(ident, "pve-ha-") {
      .pve_kind = "ha"
    }
  }
}
.
