# Template configuration for stack: openobserve (Fill in values for local deployment)
OPENOBSERVE_VERSION=v1.1.2
OPENOBSERVE_DOMAIN=openobserve.example.com
OPENOBSERVE_DATA_DIR=/srv/openobserve/data
PGID=
PUID=
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=CHANGEME
ZO_COMPACT_DATA_RETENTION_DAYS=30
VECTOR_VERSION=0.61.0
OPENOBSERVE_SYSLOG_PORT=514
OPENOBSERVE_SYSLOG_SENDERS={"192.0.2.1":{"name":"gw.example.com","vendor":"unifi"},"192.0.2.2":{"name":"nas.example.com","vendor":"synology"}}
OPENOBSERVE_INGEST_USER=admin@example.com
OPENOBSERVE_INGEST_PASSWORD=CHANGEME
