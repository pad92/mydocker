    {
      "type": "table",
      "title": "Top sources bloquées",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{log_stream=\"firewall\"} host_name:in($host_name) fw_action:in($action) fw_ruleset:in($ruleset) $search | stats by (fw_src, fw_in) count() as n, count_uniq(fw_dpt) as ports, max(_time) as dernier | sort by (n desc) | limit 20",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "topk by (ip) (1, max by (ip, mac, name) (tlast_over_time(unpoller_client_uptime_seconds{ip!=\"\"}[$__range])) or max by (ip, mac, name) (tlast_over_time(unpoller_device_info{ip!=\"\"}[$__range])))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": false
          },
          "filter": {
            "id": "byRefId",
            "options": "A"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "n",
                "destinationType": "number"
              },
              {
                "targetField": "ports",
                "destinationType": "number"
              }
            ],
            "fields": {}
          },
          "filter": {
            "id": "byRefId",
            "options": "A"
          }
        },
        {
          "id": "organize",
          "filter": {
            "id": "byRefId",
            "options": "B"
          },
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "Value #B": true
            },
            "renameByName": {
              "ip": "fw_src",
              "name": "unifi_name",
              "mac": "unifi_mac"
            },
            "indexByName": {}
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "fw_src",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "n",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "n",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "fw_src": 0,
              "fw_in": 3,
              "n": 4,
              "ports": 5,
              "dernier": 6,
              "unifi_name": 1,
              "unifi_mac": 2
            },
            "renameByName": {
              "fw_src": "source",
              "fw_in": "interface",
              "n": "paquets",
              "ports": "ports",
              "dernier": "dernier",
              "unifi_name": "nom UniFi",
              "unifi_mac": "MAC"
            },
            "excludeByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
