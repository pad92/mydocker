      "title": "Composants",
      "description": "Un composant par ligne : collecte (1 = joignable), durée depuis le dernier démarrage, redémarrages sur 24 h (Vector : séries de son uptime, un nouveau conteneur en ouvre une) et version.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (job) (up{job=~\"victoriametrics|victorialogs|vmalert-logs|vmalert-metrics|alertmanager|vector\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (job) (time() - process_start_time_seconds{job=~\"victoriametrics|victorialogs|vmalert-logs|vmalert-metrics|alertmanager|vector\"}) or min by (job) (vector_uptime_seconds{job=\"vector\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (job) (changes(process_start_time_seconds{job=~\"victoriametrics|victorialogs|vmalert-logs|vmalert-metrics|alertmanager|vector\"}[24h])) or (sum by (job) (resets(vector_uptime_seconds{job=\"vector\"}[24h])) + count by (job) (max_over_time(vector_uptime_seconds{job=\"vector\"}[24h])) - 1)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max by (job, version) (label_copy(vm_app_version, \"short_version\", \"version\")) or max by (job, version) (vector_build_info{job=\"vector\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
