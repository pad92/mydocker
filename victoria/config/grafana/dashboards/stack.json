            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "count(up{job=~\"victoriametrics|victorialogs|vmalert-logs|vmalert-metrics|alertmanager|vector\"} == 0) or vector(0)",
