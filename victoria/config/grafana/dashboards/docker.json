    {
      "type": "table",
      "title": "Messages d'erreur les plus fréquents",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{log_stream=\"docker\"} host_name:in($host_name) compose_project:in($compose_project) container_name:in($container_name) $search level:in(error,crit) | replace_regexp (\"[0-9]+\", \"N\") at _msg | extract_regexp \"^(?P<msg>.{1,200})\" from _msg | stats by (container_name, msg) count() as n, max(_time) as dernier | sort by (n desc) | limit 30",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "n",
                "destinationType": "number"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "container_name": 0,
              "msg": 1,
              "n": 2,
              "dernier": 3
            },
            "renameByName": {
              "container_name": "conteneur",
              "msg": "message (200 car., chiffres = N)",
              "n": "occurrences",
              "dernier": "dernier"
            },
            "excludeByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 16,
        "h": 10
      },
      "description": "Messages d'erreur les plus fréquents. Un même message répété en masse désigne la panne à traiter en premier."
    },
