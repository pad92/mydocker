    {
      "type": "timeseries",
      "title": "Erreurs et pertes réseau (/s)",
      "description": "Paquets en erreur ou abandonnés par l'interface, par sens. Des erreurs indiquent un câble, un port ou un pilote ; des pertes, un tampon saturé ou du trafic que le noyau refuse (VLAN, protocole inconnu).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (host_name, direction) (rate(system_network_errors_total{host_name=~\"$host_name\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}} erreurs {{direction}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (host_name, direction) (rate(system_network_dropped_total{host_name=~\"$host_name\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}} pertes {{direction}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
