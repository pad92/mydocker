    {
      "type": "timeseries",
      "title": "Inodes utilisés",
      "description": "Part des inodes occupés par système de fichiers (sans vfat, tmpfs, squashfs ni overlay). Un disque peut être plein d'inodes alors qu'il reste de l'espace : beaucoup de petits fichiers (cache, sessions, mails).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (host_name, mountpoint) (system_filesystem_inodes_usage{host_name=~\"$host_name\", type!~\"vfat|tmpfs|squashfs|overlay\", state=\"used\"}) / sum by (host_name, mountpoint) (system_filesystem_inodes_usage{host_name=~\"$host_name\", type!~\"vfat|tmpfs|squashfs|overlay\"})",
          "legendFormat": "{{host_name}} {{mountpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
