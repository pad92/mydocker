        "name": "host_name",
        "label": "Hôte",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(system_cpu_time_seconds_total, host_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(system_cpu_time_seconds_total, host_name)",
          "refId": "host_name"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
