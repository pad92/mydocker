    {
      "type": "timeseries",
      "title": "VRAM par conteneur",
      "description": "VRAM de chaque processus du GPU, nommée d'après son conteneur (record container:nvidia_smi_compute_app_used_memory_bytes, évalué chaque minute). « hors conteneur ou inconnu » : processus hors Docker, ou conteneur sans log depuis un jour. Pointillés : VRAM utilisée au total (pilote compris) et capacité.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "label_replace(sum by (host_name, container_name) (container:nvidia_smi_compute_app_used_memory_bytes{host_name=~\"$host_name\"}), \"container_name\", \"hors conteneur ou inconnu\", \"container_name\", \"\")",
          "legendFormat": "{{host_name}} {{container_name}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (host_name) (nvidia_smi_memory_used_bytes{host_name=~\"$host_name\"})",
          "legendFormat": "{{host_name}} utilisée (total)",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (host_name) (nvidia_smi_memory_total_bytes{host_name=~\"$host_name\"})",
          "legendFormat": "{{host_name}} capacité",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* (utilisée \\(total\\)|capacité)$"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
