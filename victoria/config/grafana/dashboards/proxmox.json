    {
      "type": "timeseries",
      "title": "Attente E/S et vol de CPU",
      "description": "Part du temps CPU de l'hôte passée à attendre le disque (iowait) ou prise par l'hyperviseur sous-jacent (steal, nul sur du métal nu). Un iowait élevé et durable désigne un stockage saturé.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (node) (rate(proxmox_node_cpustat_iowait_seconds_total[$__rate_interval])) / sum by (node) (rate({__name__=~\"proxmox_node_cpustat_(user|nice|system|idle|iowait|irq|softirq|steal)_seconds_total\"}[$__rate_interval]))",
          "legendFormat": "{{node}} iowait",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (node) (rate(proxmox_node_cpustat_steal_seconds_total[$__rate_interval])) / sum by (node) (rate({__name__=~\"proxmox_node_cpustat_(user|nice|system|idle|iowait|irq|softirq|steal)_seconds_total\"}[$__rate_interval]))",
          "legendFormat": "{{node}} steal",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 35,
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      }
