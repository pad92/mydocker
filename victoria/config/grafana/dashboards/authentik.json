          "editorMode": "code",
          "expr": "{log_stream=\"authentik\"} ak_kind:=forward_auth ak_app_host:in($application) | stats by (ak_app_host) count() as requetes, count() if (app_status:>=400) as refus, quantile(0.95, ak_runtime_ms) as p95_ms | sort by (requetes desc)",
