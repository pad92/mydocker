      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{log_stream=\"authentik\"} ak_kind:=event | stats count() if (ak_action:=login) as logins, count() if (ak_action:in(login_failed,invalid_identifier)) as echecs, count() if (ak_action:=logout) as logouts",
