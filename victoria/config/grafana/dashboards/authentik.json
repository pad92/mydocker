              {
                "targetField": "refus",
                "destinationType": "number"
              },
              {
                "targetField": "p95_ms",
                "destinationType": "number"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "ak_app_host": 0,
              "requetes": 1,
              "refus": 2,
              "p95_ms": 3
            },
            "renameByName": {
              "ak_app_host": "application",
              "requetes": "requêtes",
              "refus": "statut 4xx/5xx",
              "p95_ms": "p95 (ms)"
            },
            "excludeByName": {}
          }
        }
