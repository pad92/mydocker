    {
      "type": "stat",
      "title": "Alimentation",
      "description": "Source d'alimentation de l'onduleur, d'après les drapeaux NUT de upsInfoStatus : secteur (OL), sur batterie (OB), batterie faible (LB). Sur batterie, la panne de courant est en cours ; batterie faible, le NAS va déclencher l'arrêt des machines.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "clamp_max(1 + ((max(upsInfoStatus{instance=~\"$instance\", upsInfoStatus=~\"(.* )?OB( .*)?\"}) or vector(0)) and on () max(upsInfoStatus{instance=~\"$instance\"})) + 2 * ((max(upsInfoStatus{instance=~\"$instance\", upsInfoStatus=~\"(.* )?LB( .*)?\"}) or vector(0)) and on () max(upsInfoStatus{instance=~\"$instance\"})), 3)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Aucune donnée",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Secteur",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "Sur batterie",
                  "color": "orange",
                  "index": 1
                },
                "3": {
                  "text": "Batterie faible",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
