    {
      "type": "canvas",
      "title": "Internet → Freebox → gw → sw24poe → équipements",
      "description": "Vert : en ligne. Rouge : tombé (l'équipement n'est plus vu par sa sonde alors que la sonde répond). Gris : la sonde elle-même ne remonte rien, l'état est inconnu. Liens : fibre (Freebox), WAN de la gw, puis état de l'équipement en aval. Sources : fbx_exporter, unpoller, OpenTelemetry (chataigne), exporteur Synology (pads918).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max(fbx_exporter_connection_state{job=\"freebox\", state=\"up\"}) or on() vector(-1)",
          "legendFormat": "internet",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max(up{job=\"freebox\"}) or on() vector(-1)",
          "legendFormat": "freebox",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max(fbx_exporter_connection_ftth_link{job=\"freebox\"}) or on() vector(-1)",
          "legendFormat": "fibre",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(max(unpoller_device_uptime_seconds{job=\"unpoller\", name=\"gw\"}) > bool 0) or on() (0 * max(unpoller_device_info{job=\"unpoller\"})) or on() vector(-1)",
          "legendFormat": "gw",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max(unpoller_device_wan_status{job=\"unpoller\", name=\"gw\"}) or on() (0 * max(unpoller_device_info{job=\"unpoller\"})) or on() vector(-1)",
          "legendFormat": "wan",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(max(unpoller_device_uptime_seconds{job=\"unpoller\", name=\"sw24poe\"}) > bool 0) or on() (0 * max(unpoller_device_info{job=\"unpoller\"})) or on() vector(-1)",
          "legendFormat": "sw24poe",
          "instant": true,
          "range": false
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(max(unpoller_device_uptime_seconds{job=\"unpoller\", name=\"wifi-rdc\"}) > bool 0) or on() (0 * max(unpoller_device_info{job=\"unpoller\"})) or on() vector(-1)",
          "legendFormat": "wifi_rdc",
          "instant": true,
          "range": false
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(max(unpoller_device_uptime_seconds{job=\"unpoller\", name=\"wifi-etage-vie\"}) > bool 0) or on() (0 * max(unpoller_device_info{job=\"unpoller\"})) or on() vector(-1)",
          "legendFormat": "wifi_etage_vie",
          "instant": true,
          "range": false
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(max(unpoller_device_uptime_seconds{job=\"unpoller\", name=\"wifi-etage-nuit\"}) > bool 0) or on() (0 * max(unpoller_device_info{job=\"unpoller\"})) or on() vector(-1)",
          "legendFormat": "wifi_etage_nuit",
          "instant": true,
          "range": false
        },
        {
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(count(last_over_time(system_memory_utilization_ratio{host_name=~\"chataigne([.].*)?\"}[5m])) > bool 0) or on() (0 * count(last_over_time(system_memory_utilization_ratio{host_name=~\"chataigne([.].*)?\"}[24h]))) or on() vector(-1)",
          "legendFormat": "chataigne",
          "instant": true,
          "range": false
        },
        {
          "refId": "K",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max(up{job=\"synology\"}) or on() vector(-1)",
          "legendFormat": "pads918",
          "instant": true,
          "range": false
        }
      ],
