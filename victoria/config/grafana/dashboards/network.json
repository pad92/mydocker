    {
      "type": "logs",
      "title": "Avertissements et erreurs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "{log_stream=\"syslog\"} host_name:~\"^(unifi|wifi-[a-z-]+|sw24poe)([.].+)?$\" level:in(warning,error,crit,alert,emerg) | sort by (_time desc) | limit 200"
