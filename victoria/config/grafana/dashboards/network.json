    {
      "type": "table",
      "title": "Dernier log syslog par équipement",
      "description": "Un équipement qui n'envoie plus de syslog depuis longtemps est peut-être tombé.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "{log_stream=\"syslog\"} host_name:~\"^(unifi|wifi-[a-z-]+|sw24poe)([.].+)?$\" | stats by (host_name) max(_time) as dernier, count() as logs | sort by (dernier)"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "logs",
                "destinationType": "number"
              },
              {
                "targetField": "dernier",
                "destinationType": "time"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "host_name": 0,
              "dernier": 1,
              "logs": 2
            },
            "renameByName": {
              "host_name": "équipement",
              "dernier": "dernier log"
            },
            "excludeByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 10
      }
