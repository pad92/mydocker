          },
          "editorMode": "code",
          "expr": "{log_stream=\"traefik\"} app_requesthost:* -app_routername:~\"_ingest@\" app_requesthost:in($requesthost) app_servicename:in($service) app_requestmethod:in($method) app_clienthost:in($client) $search | stats by (app_requesthost) count() as n, count() if (app_downstreamstatus:>=400 app_downstreamstatus:<500) as e4xx, count() if (app_downstreamstatus:>=500) as e5xx, quantile(0.95, app_duration) if (app_downstreamstatus:>0 not app_requestpath:=\"/user/events\") as p95 | math round(p95/1000000, 0.1) as ms | sort by (n desc) | limit 30",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "n",
                "destinationType": "number"
              },
              {
                "targetField": "e4xx",
                "destinationType": "number"
              },
              {
                "targetField": "e5xx",
                "destinationType": "number"
              },
              {
                "targetField": "ms",
                "destinationType": "number"
              },
              {
                "targetField": "p95",
                "destinationType": "number"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "app_requesthost": 0,
              "n": 1,
              "e4xx": 2,
              "e5xx": 3,
              "ms": 4,
              "p95": 5
            },
            "renameByName": {
              "app_requesthost": "host",
              "n": "requêtes",
              "e4xx": "4xx",
              "e5xx": "5xx",
              "ms": "p95 (ms)",
              "p95": "p95 (ns)"
            },
            "excludeByName": {}
          }
        }
      ],
