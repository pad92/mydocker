    {
      "type": "table",
      "title": "Historique des alertes",
      "description": "Règles passées par un état actif, en attente ou en erreur sur la période, une ligne par épisode : actif depuis (début réel de l'alerte, même avant la période), première et dernière fois vue dans cet état, et la dernière raison. Les erreurs d'évaluation n'ont pas de début d'alerte et restent regroupées. Une règle à plusieurs alertes dont la plus ancienne se termine change de début et ouvre une nouvelle ligne.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{log_stream=\"alerts\"} ((alert_state:in(firing,pending) alert_severity:!=none) OR alert_health:=err) | stats by (alert_rule, alert_state, alert_health, alert_active_since) min(_time) as debut, max(_time) as fin, row_max(_time, _msg) as dernier | unpack_json from dernier fields (_msg) | delete dernier | sort by (fin desc) | limit 200",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "fin": 0,
              "debut": 1,
              "alert_rule": 2,
              "alert_state": 3,
              "alert_health": 4,
              "alert_active_since": 5,
              "_msg": 6
            },
            "renameByName": {
              "fin": "dernière fois",
              "debut": "première fois",
              "alert_rule": "règle",
              "alert_state": "état",
              "alert_health": "évaluation",
              "alert_active_since": "actif depuis",
              "_msg": "dernière raison"
            },
            "excludeByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "état"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "active",
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "text": "en attente",
                        "color": "orange",
                        "index": 1
                      },
                      "inactive": {
                        "text": "OK",
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "évaluation"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "err": {
                        "text": "erreur",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dernière fois"
            },
