    {
      "type": "table",
      "title": "État des règles",
      "description": "Une ligne par règle, état de la dernière évaluation. Raison : le texte de l'alerte (celui du SMS) quand elle est active ou en attente, l'erreur d'évaluation, ou sinon la condition surveillée.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "_time:3m {log_stream=\"alerts\"} | last 1 by (_time) partition by (alert_source, alert_rule) | format \"3\" as prio | format if (alert_state:=pending) \"2\" as prio | format if (alert_health:=err) \"1\" as prio | format if (alert_state:=firing alert_severity:!=none) \"0\" as prio | format if (alert_state:=firing alert_severity:=none) \"veille\" as alert_state | sort by (prio, alert_rule) | fields alert_rule, alert_state, alert_health, _msg, alert_active_since, alert_severity, alert_source, alert_group, alert_last_evaluation",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "alert_rule": 0,
              "alert_state": 1,
              "alert_health": 2,
              "_msg": 3,
              "alert_active_since": 4,
              "alert_severity": 5,
              "alert_source": 6,
              "alert_group": 7,
              "alert_last_evaluation": 8
            },
            "renameByName": {
              "alert_rule": "règle",
              "alert_state": "état",
              "alert_health": "évaluation",
              "_msg": "raison",
              "alert_active_since": "depuis",
              "alert_severity": "sévérité",
              "alert_source": "source",
              "alert_group": "groupe",
              "alert_last_evaluation": "dernière évaluation"
            },
            "excludeByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "état"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "active",
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "text": "en attente",
                        "color": "orange",
                        "index": 1
                      },
                      "inactive": {
                        "text": "OK",
                        "color": "green",
                        "index": 2
                      },
                      "veille": {
                        "text": "en service",
                        "color": "green",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "évaluation"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "err": {
                        "text": "erreur",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
