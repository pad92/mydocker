    {
      "type": "table",
      "title": "Services web",
      "description": "Un service par ligne, trié par taux de 5xx. Cliquer sur un service ouvre le dashboard HTTP filtré sur ce service.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{log_stream=\"traefik\"} app_requesthost:* -app_routername:~\"_ingest@\" app_servicename:* | stats by (app_servicename) count() as n, count() if (app_downstreamstatus:>=400 app_downstreamstatus:<500) as e4xx, count() if (app_downstreamstatus:>=500) as e5xx, quantile(0.95, app_duration) if (app_downstreamstatus:>0 not app_requestpath:=\"/user/events\") as p95, max(_time) as last | math round(e4xx*100/n, 0.1) as pct4, round(e5xx*100/n, 0.1) as pct5, round(p95/1000000, 0.1) as ms | fields app_servicename, n, pct4, pct5, ms, last | sort by (pct5 desc, n desc) | limit 50",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "n",
                "destinationType": "number"
              },
              {
                "targetField": "pct4",
                "destinationType": "number"
              },
              {
                "targetField": "pct5",
                "destinationType": "number"
              },
              {
                "targetField": "ms",
                "destinationType": "number"
              },
              {
                "targetField": "last",
                "destinationType": "time"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "app_servicename": 0,
              "n": 1,
              "pct4": 2,
              "pct5": 3,
              "ms": 4,
              "last": 5
            },
            "renameByName": {
              "app_servicename": "service",
              "n": "requêtes",
              "pct4": "4xx (%)",
              "pct5": "5xx (%)",
              "ms": "p95 (ms)",
              "last": "dernière requête"
            },
            "excludeByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Ouvrir dans HTTP",
                    "url": "/d/victoria-http/http?var-service=${__data.fields.service}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx (%)"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
