    {
      "type": "stat",
      "title": "Latence HTTP p95",
      "description": "95e percentile de la durée des requêtes, hors flux longs (WebSocket, /user/events).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{log_stream=\"traefik\"} app_requesthost:* -app_routername:~\"_ingest@\" | filter app_downstreamstatus:>0 not app_requestpath:=\"/user/events\" | stats quantile(0.95, app_duration) as p95",
          "queryType": "stats"
