    {
      "type": "stat",
      "title": "Taux de 5xx",
      "description": "Part des réponses HTTP 5xx sur la période.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "expr": "{log_stream=\"traefik\"} app_requesthost:* -app_routername:~\"_ingest@\" | stats count() as total, count() if (app_downstreamstatus:>=500) as e | math e*100/total as pct | fields pct",
          "queryType": "stats"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
