# Template configuration for stack: victoria (Fill in values for local deployment)
VICTORIA_LOGS_VERSION=v1.54.0
VICTORIA_METRICS_VERSION=v1.156.0
VECTOR_VERSION=0.61.0
VICTORIA_LOGS_DOMAIN=logs.example.com
VICTORIA_METRICS_DOMAIN=metrics.example.com
VICTORIA_LOGS_DATA_DIR=/srv/victoria/logs
VICTORIA_METRICS_DATA_DIR=/srv/victoria/metrics
VICTORIA_LOGS_RETENTION=30d
VICTORIA_METRICS_RETENTION=30d
PGID=
PUID=
VECTOR_SYSLOG_PORT=514
# One JSON line, no single quote: the value goes into a VRL raw string.
VECTOR_SYSLOG_SENDERS={"192.0.2.1":{"name":"gw.example.com","vendor":"unifi"},"192.0.2.2":{"name":"nas.example.com","vendor":"synology"}}
