# Template configuration for stack: victoria (Fill in values for local deployment)
VICTORIA_LOGS_VERSION=v1.54.0
VICTORIA_METRICS_VERSION=v1.156.0
VECTOR_VERSION=0.61.0
VMALERT_VERSION=v1.156.0
ALERTMANAGER_VERSION=v0.35.1
GRAFANA_VERSION=13.2.7
GRAFANA_LOGS_PLUGIN_VERSION=0.34.0
UNPOLLER_VERSION=v5.9.6
VICTORIA_LOGS_DOMAIN=logs.example.com
VICTORIA_METRICS_DOMAIN=metrics.example.com
VICTORIA_GRAFANA_DOMAIN=grafana.example.com
VICTORIA_LOGS_DATA_DIR=/srv/victoria/logs
VICTORIA_METRICS_DATA_DIR=/srv/victoria/metrics
ALERTMANAGER_DATA_DIR=/srv/victoria/alertmanager
GRAFANA_DATA_DIR=/srv/victoria/grafana
VICTORIA_LOGS_RETENTION=30d
VICTORIA_METRICS_RETENTION=30d
PGID=
PUID=
VECTOR_SYSLOG_PORT=514
# One JSON line, no single quote: the value goes into a VRL raw string.
VECTOR_SYSLOG_SENDERS={"192.0.2.1":{"name":"gw.example.com","vendor":"unifi"},"192.0.2.2":{"name":"nas.example.com","vendor":"synology"}}
# Authentik username that becomes the Grafana server admin.
GRAFANA_ADMIN_USER=admin
# Role of the other Authentik users in Grafana: Viewer, Editor or Admin.
GRAFANA_DEFAULT_ROLE=Viewer
# Free Mobile SMS API (Mon compte > Mes options > Notifications par SMS).
# Secret: set the real values only in the environment of the stack.
FREE_MOBILE_USER=
FREE_MOBILE_PASS=
# UniFi gateway polled by unpoller, and its local read-only account
# (UniFi OS, Admins & Users, View Only on Network). See the README.
UNIFI_URL=https://unifi.home.lan
# Secret: set the real values only in the environment of the stack.
UNPOLLER_USER=
UNPOLLER_PASS=
# Synology NAS polled by snmp-exporter over SNMPv3 (DSM, Control Panel,
# Terminal & SNMP, SNMPv3 with SHA and AES). See the README.
SNMP_EXPORTER_VERSION=v0.31.0
SYNOLOGY_SNMP_TARGET=nas.example.com
SYNOLOGY_SNMP_USER=snmp-victoria
# Secret: set the real values only in the environment of the stack.
SYNOLOGY_SNMP_AUTH_PASS=
SYNOLOGY_SNMP_PRIV_PASS=
# Uptime Kuma push monitor that receives the watchdog of the alert chain
# (Kuma, Add New Monitor, Push; see the README). The token is a secret: set
# the real URL only in the environment of the stack.
ALERTMANAGER_WATCHDOG_URL=https://uptime.example.com/api/push/CHANGE_ME?status=up&msg=OK
