# Template configuration for stack: management (Fill in values for local deployment)
ACME_CA_SERVER=
ACME_EMAIL=
# Authentik: generate both secrets with `openssl rand -base64 60 | tr -d '\n'`
AUTHENTIK_HOST_LOCAL=
# Optional: public FQDN when Authentik is published on the internet
AUTHENTIK_HOST_PUBLIC=
AUTHENTIK_PG_PASS=CHANGEME
AUTHENTIK_SECRET_KEY=CHANGEME
AUTHENTIK_TAG=2026.8.6
CA_CERT_NAME=example-root-ca.crt
# Same value as TODO_DOMAIN in todo/.env (OIDC redirect URI).
DONETICK_HOST_LOCAL=
# Same value as FORGEJO_DOMAIN in forgejo/.env (OIDC redirect URI).
FORGEJO_HOST_LOCAL=
# Same value as GRAMPSWEB_DOMAIN in grampsweb/.env (OIDC redirect URI).
GRAMPSWEB_HOST_LOCAL=
HOMARR_HOST_LOCAL=
HOMARR_SECRET_ENCRYPTION_KEY=CHANGEME
HOMEPAGE_HOST_LOCAL=
# Same value as TRAEFIK_HOST_LOCAL in immich/.env (OIDC redirect URIs).
IMMICH_HOST_LOCAL=
MANAGEMENT_AUTHENTIK_DATA_DIR=
MANAGEMENT_PORTAINER_DATA_DIR=
MANAGEMENT_SHARE_CA_CERTIFICATES_DATA_DIR=/usr/local/share/ca-certificates
MANAGEMENT_UPTIME_KUMA_DATA_DIR=
MIRROR_HOST_LOCAL=
# Library bookmarks of the network devices (host name or IP address).
NAS_HOST_LOCAL=
# Same value as TRAEFIK_FQDN in ng/.env (forward auth of the *arr apps).
NG_HOST_LOCAL=
PORTAINER_HOST_LOCAL=
PROXMOX_HOST_LOCAL=
PROXMOX_UPSTREAM_URL=
SWITCH_HOST_LOCAL=
# Traefik dashboard host, protected by forward auth (group traefik-users).
TRAEFIK_HOST_LOCAL=
UNIFI_HOST_LOCAL=
UPTIME_HOST_LOCAL=
# Same values as VICTORIA_LOGS_DOMAIN / VICTORIA_METRICS_DOMAIN /
# VICTORIA_GRAFANA_DOMAIN in victoria/.env (forward auth).
VICTORIA_GRAFANA_HOST_LOCAL=
VICTORIA_LOGS_HOST_LOCAL=
VICTORIA_METRICS_HOST_LOCAL=
