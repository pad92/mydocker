[http]
  [http.routers]
    [http.routers.proxmox]
      rule = 'Host(`{{ env "PROXMOX_HOST_LOCAL" }}`)'
      entryPoints = ["websecure"]
      service = "proxmox-svc"
      [http.routers.proxmox.tls]
        certResolver = "stepca"
  
  [http.services]
    [http.services.proxmox-svc.loadBalancer]
      # On lie le service au transport personnalisé ci-dessous
      serversTransport = "pveTransport"
      [[http.services.proxmox-svc.loadBalancer.servers]]
        url = '{{ env "PROXMOX_UPSTREAM_URL" }}'
  
  # pveproxy sert un certificat émis par la CA maison (rôle Ansible
  # proxmox_tls) : on le vérifie. L'URL amont est une IP, donc le nom attendu
  # dans le certificat est fixé ici. Le chemin de la CA correspond au montage
  # ${CA_CERT_NAME} du docker-compose.yml.
  [http.serversTransports.pveTransport]
    serverName = "chataigne.home.lan"
    rootCAs = ["/etc/ssl/certs/home-lan-root-ca.crt"]

  [http.middlewares.compression.compress]
    excludedContentTypes = ["text/event-stream"]

  [http.middlewares.security.headers]
    browserXssFilter = true
    contentTypeNosniff = true
    forceSTSHeader = true
    frameDeny = true
    stsIncludeSubdomains = true
    stsPreload = true
    stsSeconds = 31536000
    customFrameOptionsValue = "SAMEORIGIN"
    referrerPolicy = "same-origin"
    [http.middlewares.security.headers.customResponseHeaders]
      X-Robots-Tag = "noindex, nofollow"

# --- Configuration TLS (Certificats) ---
[tls]

  [tls.options]
    [tls.options.default] # On définit les options par défaut pour tout le TLS
      minVersion = "VersionTLS12"
      cipherSuites = [
        "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
        "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
        "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305",
        "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305"
      ]
