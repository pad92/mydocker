[http]
  [http.routers]
    [http.routers.proxmox]
      rule = 'Host(`{{ env "PROXMOX_HOST_LOCAL" }}`)'
      entryPoints = ["websecure"]
      service = "proxmox-svc"
      [http.routers.proxmox.tls]
        certResolver = "stepca"

    # Monitoring stacks on ns01 (uptime-kuma/ and beszel-hub/): they run
    # outside chataigne so that an outage of this host is still detected.
    # HTTP to HTTPS: redirect-https@docker is defined by labels of this stack.
    [http.routers.uptime_http]
      rule = 'Host(`{{ env "UPTIME_HOST_LOCAL" }}`)'
      entryPoints = ["web"]
      middlewares = ["redirect-https@docker"]
      service = "uptime-svc"
    # Login through Authentik (provider and access group: see
    # authentik/blueprints/20-forward-auth-apps.yaml).
    [http.routers.uptime]
      rule = 'Host(`{{ env "UPTIME_HOST_LOCAL" }}`)'
      entryPoints = ["websecure"]
      middlewares = ["authentik@docker"]
      service = "uptime-svc"
      [http.routers.uptime.tls]
        certResolver = "stepca"
    # Push monitors call /api/push/<token> from scripts that cannot log in.
    # They stay outside forward auth; the token in the URL is their secret.
    [http.routers.uptime_push]
      rule = 'Host(`{{ env "UPTIME_HOST_LOCAL" }}`) && PathPrefix(`/api/push/`)'
      entryPoints = ["websecure"]
      service = "uptime-svc"
      [http.routers.uptime_push.tls]
        certResolver = "stepca"

    [http.routers.beszel_http]
      rule = 'Host(`{{ env "BESZEL_HOST_LOCAL" }}`)'
      entryPoints = ["web"]
      middlewares = ["redirect-https@docker"]
      service = "beszel-svc"
    [http.routers.beszel]
      rule = 'Host(`{{ env "BESZEL_HOST_LOCAL" }}`)'
      entryPoints = ["websecure"]
      service = "beszel-svc"
      [http.routers.beszel.tls]
        certResolver = "stepca"
  
  [http.services]
    [http.services.proxmox-svc.loadBalancer]
      # On lie le service au transport personnalisé ci-dessous
      serversTransport = "pveTransport"
      [[http.services.proxmox-svc.loadBalancer.servers]]
        url = '{{ env "PROXMOX_UPSTREAM_URL" }}'
    [http.services.uptime-svc.loadBalancer]
      [[http.services.uptime-svc.loadBalancer.servers]]
        url = '{{ env "UPTIME_UPSTREAM_URL" }}'
    [http.services.beszel-svc.loadBalancer]
      [[http.services.beszel-svc.loadBalancer.servers]]
        url = '{{ env "BESZEL_UPSTREAM_URL" }}'
  
  # pveproxy sert un certificat émis par la CA maison (rôle Ansible
  # proxmox_tls) : on le vérifie. L'URL amont est une IP, donc le nom attendu
  # dans le certificat est fixé ici. Le chemin de la CA correspond au montage
  # ${CA_CERT_NAME} du docker-compose.yml.
  [http.serversTransports.pveTransport]
    serverName = "chataigne.home.lan"
    rootCAs = ["/etc/ssl/certs/home-lan-root-ca.crt"]

  # Basic auth des routes d'ingestion de la stack victoria (logs OTLP vers
  # vector, métriques OTLP vers victoriametrics) : les collecteurs ne suivent
  # pas un login Authentik. Une entrée htpasswd bcrypt par collecteur, générée
  # avec `htpasswd -nB collector`, et le même mot de passe dans myansible
  # (vault). La valeur ci-dessous n'est pas un hash valide : elle refuse tout
  # tant qu'elle n'est pas remplacée dans traefik_dynamic.toml.
  # removeHeader : l'en-tête Authorization ne part pas vers les backends.
  [http.middlewares.victoria-ingest-auth.basicAuth]
    users = ["collector:REPLACE_WITH_HTPASSWD_BCRYPT_HASH"]
    removeHeader = true

  [http.middlewares.compression.compress]
    excludedContentTypes = ["text/event-stream"]

  [http.middlewares.security.headers]
    browserXssFilter = true
    contentTypeNosniff = true
    forceSTSHeader = true
    frameDeny = true
    stsIncludeSubdomains = true
    stsPreload = true
    stsSeconds = 31536000
    customFrameOptionsValue = "SAMEORIGIN"
    referrerPolicy = "same-origin"
    [http.middlewares.security.headers.customResponseHeaders]
      X-Robots-Tag = "noindex, nofollow"

# --- Configuration TLS (Certificats) ---
[tls]

  [tls.options]
    [tls.options.default] # On définit les options par défaut pour tout le TLS
      minVersion = "VersionTLS12"
      cipherSuites = [
        "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
        "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
        "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305",
        "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305"
      ]
