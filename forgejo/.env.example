# Copy to .env, fill in the blanks and run chmod 600 .env.
# Image tag of Forgejo: 17 follows its patch releases, 17.0.2 pins one. Never
# lower than the version that last ran on the database.
FORGEJO_VERSION=17
# Image tag of the Forgejo runner: 13 follows its minor and patch releases.
FORGEJO_RUNNER_VERSION=13
USER_UID=1000
USER_GID=1000
FORGEJO_DATA_DIR=/srv/forgejo/data
FORGEJO_DB_DATA_DIR=/srv/forgejo/postgres
FORGEJO_RUNNER_DATA_DIR=/srv/forgejo/runner
# ROOT_URL is https://<FORGEJO_DOMAIN>/.
FORGEJO_DOMAIN=git.example.com
# Published SSH port, also shown in the SSH clone URLs.
FORGEJO_SSH_PORT=2222
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWORD=
# Where "uses:" actions without a host are fetched from.
FORGEJO_DEFAULT_ACTIONS_URL=https://github.com
# true only for the time of an import from the local network, see README.md.
FORGEJO_MIGRATIONS_ALLOW_LOCALNETWORKS=false
# Owner of FORGEJO_RUNNER_DATA_DIR, and the host's docker group (getent group docker).
FORGEJO_RUNNER_UID=1000
FORGEJO_RUNNER_GID=1000
DOCKER_GID=
